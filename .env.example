# Copy to .env and fill in. See docs/configuration.md for details. Never commit .env.

# --- DataHub ---------------------------------------------------------------
# Backend (GMS) URL, not the web UI. The token's user needs the "Manage Ingestion" privilege.
GMS_URL=https://<datahub-gms-host>
DATAHUB_TOKEN=

# --- DataHub's Kafka (mTLS) ------------------------------------------------
# Each KAFKA_* value is a file path or the PEM text itself.
KAFKA_BOOTSTRAP=<host>:<port>
KAFKA_CA=/certs/ca.pem
KAFKA_CERT=/certs/service.cert
KAFKA_KEY=/certs/service.key

# --- App state (Postgres) --------------------------------------------------
# Leave DATABASE_URL unset to use the bundled Postgres from docker-compose.yml.
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
# Password for the bundled Postgres. Set it before the first start.
# POSTGRES_PASSWORD=

# --- Security --------------------------------------------------------------
# Encrypts integration credentials in the database. Back it up: without it saved credentials are unreadable.
# Comma-separate keys to rotate (the first one encrypts). Generate with:
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
APP_ENCRYPTION_KEY=

# UI login. The account is created/updated from these on every start (password: 8+ characters).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Set to 1 when served over HTTPS.
# COOKIE_SECURE=1

# --- Optional tuning -------------------------------------------------------
# MCL_TOPIC=MetadataChangeLog_Versioned_v1
# KAFKA_GROUP=datahub-logs-app     # a new name replays the topic from the beginning
# STUCK_HOURS=3                    # RUNNING with no update for this long is shown as stuck
# RETENTION_DAYS=30                # delete runs older than this (0 = keep forever)
