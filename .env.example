# Copy to .env and fill in. See docs/configuration.md for details. Never commit .env.

# --- DataHub connection (optional: use the app's Settings tab instead) ------
# The Settings tab stores these encrypted in Postgres and takes precedence over these variables.
# Set them here only to pre-configure an install without touching the UI.
# GMS_URL=https://<datahub-gms-host>      # backend (GMS) URL, not the web UI
# DATAHUB_TOKEN=                          # user needs the "Manage Ingestion" privilege
# KAFKA_BOOTSTRAP=<host>:<port>
# KAFKA_CA=/certs/ca.pem                  # file path or the PEM text itself
# KAFKA_CERT=/certs/service.cert
# KAFKA_KEY=/certs/service.key

# --- App state (Postgres) --------------------------------------------------
# Leave DATABASE_URL unset to use the bundled Postgres from docker-compose.yml.
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
# Password for the bundled Postgres. Set it before the first start.
# POSTGRES_PASSWORD=

# --- Security --------------------------------------------------------------
# The image ships public defaults for these (ADMIN_PASSWORD=change-me-now and a fixed encryption key), so
# the app starts without them, but the Settings tab warns until you replace them. Set your own here.
#
# UI login (password: 8+ characters).
# ADMIN_USER=admin
# ADMIN_PASSWORD=
#
# Encrypts credentials in the database. Back it up: without it saved credentials are unreadable.
# To change it later use NEWKEY,OLDKEY (new first). Generate with:
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# APP_ENCRYPTION_KEY=

# The session cookie is marked Secure automatically behind HTTPS (X-Forwarded-Proto). Force it with:
# COOKIE_SECURE=1

# --- Optional tuning -------------------------------------------------------
# MCL_TOPIC=MetadataChangeLog_Versioned_v1
# KAFKA_GROUP=datahub-logs-app     # a new name replays the topic from the beginning
# STUCK_HOURS=3                    # RUNNING with no update for this long is shown as stuck
# RETENTION_DAYS=7                # delete runs older than this (0 = keep forever); 2 if log browsing is disabled
# DISABLE_LOG_BROWSING=1          # no Runs tab / runs API: only collect and forward, keep logs just for delivery
